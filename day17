14. Solution
function App() {
  const age = 16;
  const hasID = true;

  return (
    <div>
      <h2>
        {age >= 18 ? "Eligible to Vote" : "Not Eligible"}
      </h2>

      {hasID && <p>Identity Verified</p>}
    </div>
  );
}

export default App;
Line-by-Line
const age = 16; → Stores the user's age.
const hasID = true; → Stores whether the user has an ID.
{age >= 18 ? ... : ...} → Uses a ternary operator to display the correct message.
{hasID && <p>...</p>} → Displays the paragraph only when hasID is true.
