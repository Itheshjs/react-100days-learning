✅ 17. Mini Challenge Solution
import { useEffect, useState } from "react";

function DigitalClock() {
  const [time, setTime] = useState(new Date());

  useEffect(() => {
    const timer = setInterval(() => {
      setTime(new Date());
    }, 1000);

    return () => {
      clearInterval(timer);
    };
  }, []);

  return (
    <div>
      <h1>Digital Clock</h1>

      <h2>
        {time.toLocaleTimeString()}
      </h2>
    </div>
  );
}

export default DigitalClock;
