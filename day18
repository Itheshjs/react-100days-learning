13. Complete Solution
function App() {
  const products = [
    {
      id: 1,
      name: "Laptop",
      price: 55000,
      inStock: true,
    },
    {
      id: 2,
      name: "Phone",
      price: 25000,
      inStock: false,
    },
    {
      id: 3,
      name: "Headphones",
      price: 3000,
      inStock: true,
    },
  ];

  return (
    <div>
      <h1>Our Products</h1>

      {products.map((product) => (
        <div key={product.id}>
          <h2>{product.name}</h2>

          <p>₹{product.price}</p>

          <p>
            {product.inStock ? "In Stock" : "Out of Stock"}
          </p>

          <hr />
        </div>
      ))}
    </div>
  );
}

export default App;
